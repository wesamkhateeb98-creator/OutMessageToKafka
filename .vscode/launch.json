{
  // Start the demo containers first: cd demo && docker compose up -d --wait
  // Send a request: curl -X POST http://localhost:5106/messages -H 'Content-Type: application/json' -d '{"name":"a","email":"a@b.c"}'
  "version": "0.2.0",
  "configurations": [
    {
      "name": "s1 await",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare debug",
      "program": "${workspaceFolder}/demo/DemoApi/bin/Debug/net10.0/DemoApi.dll",
      "args": [
        "--solution=s1",
        "--urls=http://localhost:5101",
        "--Demo:Topic=demo-debug",
        "--Demo:DataDirectory=${env:HOME}/.cache/outmessage-demo/debug/s1"
      ],
      "cwd": "${workspaceFolder}/demo/DemoApi",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "integratedTerminal"
